    {
      "id": 1,
      "type": "comment",
      "name": "comment",
      "x": 53.875,
      "y": 47,
      "jacks": {},
      "text": "Syntona has modules that can be connected together. Modules have input and output jacks where connections are made.\n\nThis patch has a \"knob\" and a \"show \"module. Click in the middle of the knob and move the mouse up and down. The knob sends messages with a number to the show module, which displays the number.\n\nThere is also a knob and a show module that are not connected. You can connect them. Click on the output jack of the knob and drag a line over to the input jack of the show module and then release the mouse. Keep trying until you are able to connect them.\n\nWhen you are done, click the \">> Next\" link at the top right of this window to move to the next page.",
      "w": 365.625,
      "h": 378.875
    },
    {
      "id": 2,
      "type": "knob",
      "name": "knob",
      "x": 425.875,
      "y": 89,
      "jacks": {
        "in": {
          "v": 0,
          "min": 0,
          "max": 100
        }
      }
    },
